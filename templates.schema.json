{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/anita-app/templates/main/templates.schema.json",
  "title": "Anita project templates",
  "type": "object",
  "required": ["schemaVersion", "categories", "templates"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string" },
          "icon": { "$ref": "#/$defs/icon" }
        },
        "additionalProperties": false
      }
    },
    "templates": {
      "type": "array",
      "items": { "$ref": "#/$defs/template" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "icon": {
      "type": "string",
      "description": "Name of an Ionicons icon in camelCase, e.g. bookOutline (https://ionic.io/ionicons)."
    },
    "template": {
      "type": "object",
      "required": ["id", "title", "description", "category", "sections"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "description": "id of one of the categories" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "icon": { "$ref": "#/$defs/icon" },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["key", "title", "fields"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z0-9]+$", "description": "Unique within the template; used by childOf." },
        "title": { "type": "string" },
        "icon": { "$ref": "#/$defs/icon" },
        "childOf": { "type": "array", "items": { "type": "string" }, "description": "Keys of parent sections: records of this section can be linked to records of those sections." },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": ["label", "fieldName", "componentCode"],
      "properties": {
        "label": { "type": "string" },
        "fieldName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$", "not": { "enum": ["id", "createdAt", "updatedAt", "parentsInfo", "createdBy"] } },
        "componentCode": {
          "enum": [1, 2, 3, 4, 5, 8, 9, 12],
          "description": "1 short text, 2 long text (rich), 3 check box, 4 drop-down list, 5 alternative choice, 8 date, 9 date & time, 12 plain long text"
        },
        "type": {
          "enum": ["text", "email", "number", "password", "color", "range", "tel", "url", "date", "month", "week", "datetime-local", "time"],
          "description": "1: text|email|number|password|color|range|tel|url; 8: date|month|week; 9: datetime-local|time"
        },
        "options": {
          "type": "array",
          "description": "Choices of drop-down lists (4) and alternative choices (5).",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": { "value": { "type": ["string", "number"] }, "label": { "type": "string" } },
            "additionalProperties": false
          }
        },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
